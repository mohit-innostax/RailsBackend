<h1>Create a New Task</h1>

<%= form_with url: "/create-task", method: :post, local: true,data: { turbo_frame: "todos", controller: "search", action: "keydown@window->search#submit",target: "search.form" } do |f| %>
  <div>
    <%= f.label :title, "Task Title" %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :priority, "Priority Level" %>
    <%= f.text_field :priority %>
  </div>

  <div>
    <%= f.label :isCompleted, "Mark as Completed" %>
    <%= f.text_field :isCompleted %>
  </div>
  <%= f.hidden_field :createdby, value: current_user.id %>
  <div>
    <%= f.submit "Create Task" %>
  </div>
<% end %>
