<%= stylesheet_link_tag "index", media: "all" %>
<h1 class="text-5xl "> All todo are </h1>
<div data-controller="search">
  <input type="text" placeholder="Search tasks..." 
    data-action="input->search#fetchTasks"
    data-search-target="input">
  <ul data-search-target="taskList">
    <% @todos.each do |todo| %>
        <turbo-frame id="todo_<%= todo["id"]%>">
            <li class="" ><%= todo["title"] %></li>
        </turbo-frame>    
    <% end %>
  </ul>
</div>
<%= render partial: "testing/temp" %>
<turbo-frame id="todos">
<ul>
    <% @todos.each do |todo_app| %>
        <%= render partial:"heading", locals: {todo_app:todo_app} %>
    <%end%>   
</ul>
</turbo-frame>
<div><%= link_to "Create New Task", "/new-task"%></div>
<div><%= link_to "Register a user", "/new-user"%></div>
<div><%= link_to "Login", "/old-user"%></div>