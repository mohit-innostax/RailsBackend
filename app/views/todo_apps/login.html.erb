<h1>Create a New user</h1>

<%= form_with url: "/login", method: :post, local: true do |f| %>

  <div>
    <%= f.label :email, "E mail" %>
    <%= f.text_field :email %>
  </div>

  <div>
    <%= f.label :password, "password" %>
    <%= f.text_field :password %>
  </div>

  <div>
    <%= f.submit "Login" %>
  </div>
<% end %>
